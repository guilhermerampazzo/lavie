# App
APP_PORT_INTERNAL=3000
API_PORT_INTERNAL=4000
PUBLIC_URL=https://painel.usejoiaslavie.com.br
STORE_URL=https://www.usejoiaslavie.com.br
NODE_ENV=development

# Postgres (CRM)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://lavie:change-me@postgres:5432/lavie

# Redis (CRM)
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=lavie
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=lavie

# Auth
AUTH_SECRET=change-me
AUTH_URL=https://painel.usejoiaslavie.com.br/auth
API_INTERNAL_URL=http://api:4000

# Nuvemshop
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_USER_AGENT=La Vie CRM (contato@lavie.com.br)

# Bling (ERP fiscal/financeiro) — fluxo OAuth2, ver seção "Bling" do CLAUDE.md.
# Cadastre o app em developer.bling.com.br/aplicativos com:
#   Link de redirecionamento = ${PUBLIC_URL}/api/bling/callback
# BLING_ACCESS_TOKEN/BLING_REFRESH_TOKEN abaixo são só um fallback manual —
# depois de preencher CLIENT_ID/SECRET, use o botão "Conectar ao Bling" em
# /configuracoes para autorizar e o token passa a ser salvo/renovado sozinho.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_ACCESS_TOKEN=
BLING_REFRESH_TOKEN=

# Evolution API (fase 4 — profile "evolution")
EVOLUTION_URL=http://evolution:8080
EVOLUTION_PUBLIC_URL=https://evo.usejoiaslavie.com.br
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=lavie
EVOLUTION_POSTGRES_PASSWORD=change-me

# IA — Módulo 2 (cadastro inteligente de produtos)
# Gateway OpenAI-compatible (padrão: OpenCode Go, mesmo usado pelo Hermes).
# AI_API_KEY aceita a OPENCODE_GO_API_KEY diretamente.
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_FALLBACK_MODEL=deepseek-v4-flash
AI_VISION_MODEL=mimo-v2.5
# AI_API_STYLE=openai | anthropic (auto-detectado pela base URL)
AI_API_STYLE=openai
AI_TIMEOUT_MS=60000
